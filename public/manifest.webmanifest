{
  "name": "FindTrail",
  "short_name": "FindTrail",
  "description": "A clear path to finding what’s missing.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#fdf8f1",
  "theme_color": "#113d34",
  "orientation": "portrait-primary",
  "categories": ["utilities", "productivity", "lifestyle"],
  "icons": [
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "./screenshots/home.png", "sizes": "412x915", "type": "image/png", "form_factor": "narrow", "label": "Choose a missing item from FindTrail’s calm home screen" },
    { "src": "./screenshots/trail.png", "sizes": "412x915", "type": "image/png", "form_factor": "narrow", "label": "Follow one focused search stop at a time" }
  ],
  "shortcuts": [
    { "name": "Start a search", "short_name": "Find something", "url": "./?start=1", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Take a reset", "short_name": "Reset", "url": "./?screen=calm", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] }
  ]
}
